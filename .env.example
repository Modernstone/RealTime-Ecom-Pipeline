# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_db
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=your_secure_password_here

# Airflow Configuration
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__WEBSERVER__WEB_SERVER_PORT=8080
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow_user:airflow_pass@postgres:5432/airflow_db
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__CORE__LOAD_DEFAULT_CONNECTIONS=False

# Pipeline Configuration
PIPELINE_BATCH_SIZE=1000
PIPELINE_LOG_LEVEL=INFO
PIPELINE_DATA_DIR=data
PIPELINE_RAW_DIR=data/raw
PIPELINE_PROCESSED_DIR=data/processed

# Dashboard Configuration
DASHBOARD_PORT=8501
DASHBOARD_HOST=0.0.0.0

# API Configuration (for future real API integration)
API_BASE_URL=https://api.example.com/ecommerce
API_KEY=your_api_key_here
API_TIMEOUT=30
